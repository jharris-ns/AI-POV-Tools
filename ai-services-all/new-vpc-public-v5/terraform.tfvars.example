# Full Netskope AI Gateway Deployment in a new VPC (AIG, DLPoD, Guardrails GPU, Bastion, Win11, LibreChat)
# ──────────────────────────────────────────────────────────────────────────────
# Copy this file to terraform.tfvars and review the sections marked REQUIRED.
# All other values have working defaults and may be left as-is for most POVs.
# Full documentation: README.md

# ── Netskope Tenant ─ Credentials (REQUIRED) ──────────────────────────────────
# PREFERRED: Set these environment variables via terminal/CLI.
#   export NETSKOPE_SERVER_URL="https://TENANT_NAME.goskope.com/api/v2"
#   export NETSKOPE_API_KEY="nsapi_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx_v1"
#   export TF_VAR_netskope_onpremappliance_licensekey="XXXXXXXX-XXXXXXXX-XXXXXXXXX-XXXXXXX-XXXXXXXX-XXXXXX-XXXXXXXXXXXXXXXXXXXX-XXXXXXXX"
#
# ALTERNATIVE: Set the environment variables here.
# WARNING: These will appear in the local Terraform state files.
#netskope_server_url = "https://TENANT_NAME.goskope.com/api/v2" # Netskope Tenant APIv2 Base URL
#netskope_api_key    = "nsapi_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx_v1" # RBAC Service Account API Token
#netskope_onpremappliance_licensekey = "XXXXXXXX-XXXXXXXX-XXXXXXXXX-XXXXXXX-XXXXXXXX-XXXXXX-XXXXXXXXXXXXXXXXXXXX-XXXXXXXX" # Netskope On-Prem Appliance License Key (single tenant key for all Netskope On-Prem Appliances)


# ── Netskope Tenant ─ AIG Config (REQUIRED) ───────────────────────────────────
# Display name shown in the Netskope tenant (1-15 characters). This must be unique within the tenant.
aig_netskope_name = "aig-tf-01"


# ── AWS ─ General (REQUIRED) ──────────────────────────────────────────────────
# Unique prefix for the names of all AWS resources (Name tags and name attributes): lowercase letters,
# digits and hyphens, 1-20 characters. Produces e.g. <prefix>-vpc, <prefix>-aig, <prefix>-guardrails.
aws_object_unique_prefix = "mylab-01"

# AWS region to deploy all resources
aws_region = "us-east-1"

# Availability zone for all subnets. Must be valid for aws_region.
# Check with: aws ec2 describe-availability-zones --region YOUR_REGION --query 'AvailabilityZones[*].ZoneName'
availability_zone = "us-east-1a"


# ── AWS — Tags (REQUIRED) ─────────────────────────────────────────────────────
# Applied to every taggable AWS resource via the provider's default_tags.

# REQUIRED: Email address of the person responsible for this deployment.
aws_tag_owner = "user@example.com"

# REQUIRED: Purpose of this deployment. Recommended: prod, dev, test, lab, pov, demo, integration, core
# Letters, numbers, spaces and _ . : / = + - @ only, up to 256 characters.  CANNOT INCLUDE COMMAS.
aws_tag_purpose = "pov"

# REQUIRED: Date after which this deployment may be torn down (YYYY-MM-DD).
aws_tag_terminate_after = "2026-12-31"

# OPTIONAL: Project name. Omit or leave empty to skip the 'project' tag.
# Letters, numbers, spaces and _ . : / = + - @ only, up to 256 characters.  CANNOT INCLUDE COMMAS.
#aws_tag_project = "netskope-pov"

# OPTIONAL: Free-text description. Omit or leave empty to skip the 'description' tag.
# Letters, numbers, spaces and _ . : / = + - @ only, up to 256 characters.  CANNOT INCLUDE COMMAS.
#aws_tag_description = "Fully automated deployment of AI Gateway + Guardrails GPU + DLPoD"


# ── AWS ─ VPC / Networking (OPTIONAL) ─────────────────────────────────────────
# These CIDRs work for most POVs. Change them if they overlap with networks
# you need to connect to this VPC (e.g. via VPC peering or Transit Gateway).

vpc_cidr            = "10.0.0.0/16"
public_subnet_cidr  = "10.0.1.0/24" # AIG instance (EIP) + NAT Gateway
private_subnet_cidr = "10.0.2.0/24" # Guardrails GPU instance (no public IP)


# ── EC2 ─ AIG (REQUIRED) ──────────────────────────────────────────────────────

# AMI ID for the Netskope AI Gateway appliance in your target region.
# Subscribe on AWS Marketplace; the AMI ID is displayed after accepting terms.
# The value below is a placeholder — update it for your region.
# AIG 1.10.93 (Nov 13, 2026) in us-east-1
aig_ami_id = "ami-0b37414692d1ef19d"

# c6a.4xlarge (16 vCPU, 32 GB RAM) is the recommended minimum.
aig_instance_type = "c6a.4xlarge"

# Fixed private IP for the AIG. Must be within public_subnet_cidr.
aig_private_ip = "10.0.1.20"

# CIDRs allowed to reach the AI Gateway on TCP port 443.
# Every entry must be in CIDR notation; single IP addresses must
# include "/32" (203.0.113.25/32). The default is ["10.0.0.0/16"] which matches
# the default vpc_cidr above.
# Examples: VPC only, VPC + specific public IPs, VPC + Netskope Public Subnets.
aig_allowed_cidr_blocks = ["10.0.0.0/16"]
#aig_allowed_cidr_blocks = ["10.0.0.0/16", "203.0.113.25/32"]
#aig_allowed_cidr_blocks = ["10.0.0.0/16", "163.116.128.0/17", "162.10.0.0/17", "8.36.116.0/24", "8.39.144.0/24", "31.186.239.0/24"]


# ── EC2 ─ DLPoD (REQUIRED) ────────────────────────────────────────────────────

# AMI ID for the Netskope DLPoD appliance in your target region.
# Obtain from Netskope — AMI IDs are region-specific.
# The value below is for us-east-1 — update for other regions.
# netskope-dlp-143.0.9 in us-east-1
dlpod_ami_id = "ami-0ea365bb2da7b5a1f"

# c5d.4xlarge (Intel NVMe, 16 vCPU / 32 GB) is recommended for faster nsbootstrap init.
# c5ad.4xlarge (AMD NVMe) is equivalent but not available in us-west-1.
dlpod_instance_type = "c5d.4xlarge"
dlpod_private_ip    = "10.0.2.20"
dlpod_persona       = "dlp-on-demand"
dlpod_hostname      = "dlp.aig.internal"


# ── EC2 ─ Guardrails (REQUIRED) ───────────────────────────────────────────────

# OPTION 1: Pre-built Guardrails AMI (Ubuntu-based, with NVIDIA driver, NVIDIA
# Container Toolkit, Docker and the LLM image pre-installed). Region-specific.
# Out-of-date components are upgraded at first boot.
# guardrails-gpu-20261103 in us-east-1
guardrails_ami_id = "ami-012a9272a063f0eaa"

# OPTION 2: Leave AMI ID empty to use stock Ubuntu 24.04 and install everything
# at first boot (20-30 minutes). Requires in-region S3 access to the Guardrails
# LLM container package (aisecurity-llm.tgz). The S3 bucket and key are only used
# if a Guardrails AMI is not provided. If needed, upload aisecurity-llm.tgz to
# S3 bucket before running terraform apply.
#   aws s3 mb s3://my-guardrails-bucket --region us-east-1
#   aws s3 cp aisecurity-llm.tgz s3://my-guardrails-bucket/aisecurity-llm.tgz
#guardrails_ami_id = ""
#guardrails_llm_image_s3_bucket = "my-guardrails-bucket"
#guardrails_llm_image_s3_key    = "aisecurity-llm.tgz"

# REQUIRED: volume_size_gb (next section) must be >= the AMI's root snapshot size.
volume_size_gb = 100

# REQUIRED: Instance Type
# g4dn.xlarge (1x NVIDIA T4, 4 vCPU, 16 GB RAM) is the minimum GPU instance.
# Use g5.xlarge (1x NVIDIA A10G) for higher LLM throughput.
guardrails_instance_type = "g4dn.xlarge"

# Fixed private IP for the Guardrails instance. Must be within private_subnet_cidr.
# This address is embedded in the AIG bootstrap secret at plan time.
# Do not change this value after running terraform apply.
guardrails_private_ip = "10.0.2.10"


# ── EC2 ─ Bastion Host (OPTIONAL) ─────────────────────────────────────────────

# The bastion signs and installs the AIG certificate, sets the AIG's DLP and
# Guardrails hosts (if bootstrap failed), and reports the AIG's readiness.
# Leave true until the AIG is fully set up; then set false and apply to remove
# the bastion and its secrets. The AIG, DLPoD and Guardrails keep working.
enable_bastion = true

# Fixed private IP for the bastion. Must be within public_subnet_cidr.
bastion_private_ip = "10.0.1.10"

# CIDRs allowed to SSH (TCP 22) to the bastion. Applies only when enable_bastion
# is true. Every entry must be in CIDR notation; single IP addresses must
# include "/32" (203.0.113.25/32). The default is ["10.0.0.0/16"] which matches
# the default vpc_cidr above.
# Examples: VPC only, VPC + specific public IPs, VPC + Netskope Public Subnets.
bastion_allowed_cidr_blocks = ["10.0.0.0/16"]
#bastion_allowed_cidr_blocks = ["10.0.0.0/16", "203.0.113.25/32"]
#bastion_allowed_cidr_blocks = ["10.0.0.0/16", "163.116.128.0/17", "162.10.0.0/17", "8.36.116.0/24", "8.39.144.0/24", "31.186.239.0/24"]


# ── EC2 ─ Windows 11 VM (OPTIONAL) ────────────────────────────────────────────
# A Windows 11 desktop in the public subnet with an Elastic IP. RDP is allowed from
# win_allowed_cidr_blocks (above) and the VM can reach every other instance.
# AWS publishes no Windows 11 AMI for EC2: win11_ami_id must be your own licensed
# image in aws_region (VM Import/Export, or EC2 Image Builder from an ISO).
#enable_win11_vm = false
#win11_ami_id    = "ami-xxxxxxxxxxxxxxxxx"

#win11_instance_type = "m5.xlarge"

# "default" (default) or "dedicated". Windows 11 BYOL may require dedicated
# hardware, which AWS bills at an additional hourly rate.
#win11_tenancy = "default"

# Fixed private IP. Must be within public_subnet_cidr and differ from the AIG's
# and the bastion's.
#win11_private_ip = "10.0.1.30"

# CIDRs allowed to RDP (TCP 3389) to the Windows 11 VM. Applies only when enable_win11_vm
# is true. Every entry must be in CIDR notation; single IP addresses must
# include "/32" (203.0.113.25/32). The default is ["10.0.0.0/16"] which matches
# the default vpc_cidr above.
# Examples: VPC only, VPC + specific public IPs, VPC + Netskope Public Subnets.
#win_allowed_cidr_blocks = ["10.0.0.0/16"]
#win_allowed_cidr_blocks = ["10.0.0.0/16", "203.0.113.25/32"]
#win_allowed_cidr_blocks = ["10.0.0.0/16", "163.116.128.0/17", "162.10.0.0/17", "8.36.116.0/24", "8.39.144.0/24", "31.186.239.0/24"]


# ── EC2 ─ LibreChat (OPTIONAL) ────────────────────────────────────────────────
# A LibreChat chat UI on its own instance in the public subnet, with an Elastic IP.
# nginx serves it over HTTPS on 443 with a certificate signed by the lab root CA,
# from librechat_allowed_cidr_blocks (above). Registration is open. Nothing is
# preconfigured: no LLM or MCP endpoint. Browsers need to trust the lab root CA.
#enable_librechat = false

#librechat_instance_type = "t3.medium"

# Image tag of ghcr.io/danny-avila/librechat. "latest" follows new releases; set a
# release tag for a repeatable deployment. Changing it replaces the instance and
# loses its chats and accounts.
#librechat_image_tag = "latest"

# Server certificate validity in days. Keep it shorter than ca_new_days.
#librechat_cert_validity_period_days = 90

# Fixed private IP. Must be within public_subnet_cidr and differ from the other
# instances'.
#librechat_private_ip = "10.0.1.40"

# CIDRs allowed to reach LibreChat over HTTPS (TCP 443). Applies only when enable_librechat
# is true. Every entry must be in CIDR notation; single IP addresses must
# include "/32" (203.0.113.25/32). The default is ["10.0.0.0/16"] which matches
# the default vpc_cidr above.
# WARNING: LibreChat registration is open, so this list is the only access control;
# keep it to your own source IPs.
# Examples: VPC only, VPC + specific public IPs, VPC + Netskope Public Subnets.
#librechat_allowed_cidr_blocks = ["10.0.0.0/16"]
#librechat_allowed_cidr_blocks = ["10.0.0.0/16", "203.0.113.25/32"]
#librechat_allowed_cidr_blocks = ["10.0.0.0/16", "163.116.128.0/17", "162.10.0.0/17", "8.36.116.0/24", "8.39.144.0/24", "31.186.239.0/24"]


# ── Signing CA (OPTIONAL) ─────────────────────────────────────────────────────
# The CA is used to sign certificates for both the AIG and DLPoD. The DLPoD server
# certificate is signed by Terraform in dlpod.tf and written to
# <dlpod_hostname>-cert.pem; that leaf certificate is what the AIG receives as
# dlp.certificate. The bastion signs the CSR
# generated by the AIG with this CA. The CA key and certificate are stored
# in Secrets Manager and downloaded by the bastion to /home/ssm-user/ as
# lab-root-ca-key.pem and lab-root-ca-cert.pem.

# Local path to an existing CA signing private key (PEM) and its matching
# certificate. When the key path is set no signing key is created, and the
# certificate path is required. Leave both blank to generate a new root CA with
# openssl: <aws_object_unique_prefix>-root-ca-key.pem and <aws_object_unique_prefix>-root-ca-cert.pem in this directory
# (*.pem is gitignored), built from the ca_new_* values below.
#ca_existing_signing_key_local_path  = ""
#ca_existing_signing_cert_local_path = ""

# New root CA settings (only used when ca_existing_signing_key_local_path is blank).
# ca_new_subj is in openssl req -subj format; each ca_new_addext entry is one -addext value.
ca_new_subj = "/C=US/ST=CA/L=SantaClara/O=NetskopeLab/OU=Security/CN=Netskope Lab Root CA/emailAddress=admin@lab.internal"
ca_new_addext = [
  "basicConstraints=critical,CA:TRUE",
  "keyUsage=critical,keyCertSign,cRLSign",
]
ca_new_algorithm = "RSA" # only RSA is supported
ca_new_rsa_bits  = 2048  # 2048, 3072 or 4096
ca_new_days      = 365


# ── AIG - Cert (OPTIONAL) ─────────────────────────────────────────────────────
# Subject and key settings for the certificate whose CSR the AIG generates (to be
# signed by the signing CA above). The CN is not configurable: it is always the
# AIG's AWS-generated public DNS name (output aig_fqdn). Optional fields may be
# omitted or set to null.

# OPTIONAL: Subject fields (O, OU, email, C, ST, L).
aig_cert_organization      = "NetskopeLab" # max 256 chars
aig_cert_organization_unit = "Security"    # max 256 chars
aig_cert_email             = "admin@lab.internal"
aig_cert_country           = "US" # exactly 2 alphabetic characters
aig_cert_state             = "CA" # max 256 chars
aig_cert_city              = "SantaClara" # max 256 chars

# OPTIONAL: Private key. Algorithm is ecdsa, rsa or ed25519 (ecdsa P-256 when unset).
aig_cert_key_algorithm = "ecdsa"
aig_cert_key_size      = "2048" # RSA only: 2048, 3072 or 4096
aig_cert_key_curve     = "P256" # ECDSA only: P256, P384 or P521

# Certificate validity in days. Keep it shorter than the signing CA's validity
# (ca_new_days) so the leaf does not outlive its CA.
aig_cert_validity_period_days = 90


# ── DLPoD - Cert (OPTIONAL) ───────────────────────────────────────────────────
# Subject, key and validity of the DLPoD server certificate, signed by the signing
# CA above and installed through the DLPoD bootstrap. The DNS SAN is always
# dlpod_hostname and the IP SAN dlpod_private_ip. Optional fields may be omitted
# or set to null.

# OPTIONAL: Certificate CN (max 256 chars). Defaults to dlpod_hostname.
# dlpod_cert_common_name = "dlp.aig.internal"

# OPTIONAL: Subject fields (O, OU, C, ST, L).
dlpod_cert_organization      = "NetskopeLab" # max 256 chars
dlpod_cert_organization_unit = "Security"    # max 256 chars
dlpod_cert_country           = "US"          # exactly 2 alphabetic characters
dlpod_cert_state             = "CA"          # max 256 chars
dlpod_cert_city              = "SantaClara"  # max 256 chars

# Private key. Only RSA is supported; bits are 2048, 3072 or 4096.
dlpod_cert_key_algorithm = "RSA"
dlpod_cert_rsa_bits      = 2048

# Certificate validity in days. Keep it shorter than the signing CA's validity
# (ca_new_days) so the leaf does not outlive its CA.
dlpod_cert_validity_period_days = 90


# ── SSH Keys (OPTIONAL) ───────────────────────────────────────────────────────
# A new AWS key pair, <aws_object_unique_prefix>-keypair, is created from a private
# key and is always used by the AIG. The private key is stored in Secrets Manager
# and downloaded by the bastion so it can SSH to the AIG.

# Local path to an existing unencrypted SSH private key (PEM or OpenSSH format).
# Leave blank to generate a private key locally, written to my-private-key.pem in
# this directory. A path that does not exist, or a file that is not a valid private
# key, fails terraform plan. Keep the key out of version control (*.pem is gitignored).
# keypair_existing_private_key_local_path = ""

# Existing AWS EC2 key pair to use for each instance below. Leave blank to use the
# new <aws_object_unique_prefix>-keypair. A non-blank value must name a key pair that
# already exists in aws_region (aws ec2 describe-key-pairs --region YOUR_REGION).
#bastion_key_pair_name    = ""
#guardrails_key_pair_name = ""
#dlpod_key_pair_name      = ""
#win11_key_pair_name      = "" # used only when enable_win11_vm = true
#librechat_key_pair_name  = "" # used only when enable_librechat = true


# ── Deployment Order (OPTIONAL) ───────────────────────────────────────────────
# Which readiness gates Terraform waits for before creating the next component.
# All default to false (no waiting); set true to wait.

# DLPoD creation waits for Guardrails to be healthy (about 30 minutes).
#wait_for_guardrails_to_deploy_dlpod = false

# AIG creation waits for Guardrails to be healthy (about 30 minutes).
#wait_for_guardrails_to_deploy_aig = false

# AIG creation waits for DLPoD's HTTPS service to answer.
#wait_for_dlpod_to_deploy_aig      = false

# terraform apply waits until the AIG is enrolled and configured (needs the bastion).
#wait_for_aig_to_complete_template = false
